      "source": [
        "import hashlib\n",
        "import hmac\n",
        "import logging\n",
        "import os\n",
        "import re\n",
        "import secrets\n",
        "import sqlite3\n",
        "from contextlib import contextmanager\n",
        "from datetime import datetime, timedelta\n",
        "from decimal import Decimal, InvalidOperation\n",
        "from getpass import getpass\n",
        "\n",
        "DB_NAME = \"bank.db\"\n",
        "MAX_ATTEMPTS = 5\n",
        "LOCK_MINUTES = 15\n",
        "MAX_AMOUNT = Decimal(\"1000000\")\n",
        "\n",
        "logging.basicConfig(\n",
        "    filename=\"bank_audit.log\",\n",
        "    level=logging.INFO,\n",
        "    format=\"%(asctime)s %(levelname)s %(message)s\",\n",
        ")\n",
        "\n",
        "class BankError(Exception):\n",
        "    \"\"\"Business-rule error whose message is safe to show to the user.\"\"\"\n",
        "    pass\n",
        "\n",
        "def connect_db():\n",
        "    con = sqlite3.connect(DB_NAME, timeout=10, isolation_level=None)\n",
        "    con.execute(\"PRAGMA foreign_keys = ON\")\n",
        "    return con\n",
        "\n",
        "@contextmanager\n",
        "def db_transaction():\n",
        "    \"\"\"BEGIN IMMEDIATE locks the DB for writing, so the balance check and the\n",
        "    insert happen atomically (prevents race conditions / double spending).\"\"\"\n",
        "    con = connect_db()\n",
        "    try:\n",
        "        con.execute(\"BEGIN IMMEDIATE\")\n",
        "        yield con\n",
        "        con.execute(\"COMMIT\")\n",
        "    except BaseException:\n",
        "        if con.in_transaction:\n",
        "            con.execute(\"ROLLBACK\")\n",
        "        raise\n",
        "    finally:\n",
        "        con.close()\n",
        "\n",
        "def init_db():\n",
        "    con = connect_db()\n",
        "    con.execute(\"\"\"\n",
        "        CREATE TABLE IF NOT EXISTS accounts (\n",
        "            acc_no TEXT PRIMARY KEY,\n",
        "            name TEXT NOT NULL,\n",
        "            phone TEXT NOT NULL,\n",
        "            email TEXT NOT NULL,\n",
        "            address TEXT NOT NULL,\n",
        "            pin TEXT NOT NULL,\n",
        "            created_at TEXT NOT NULL,\n",
        "            failed_attempts INTEGER NOT NULL DEFAULT 0,\n",
        "            locked_until TEXT,\n",
        "            is_active INTEGER NOT NULL DEFAULT 1\n",
        "        )\n",
        "    \"\"\")\n",
        "    con.execute(\"\"\"\n",
        "        CREATE TABLE IF NOT EXISTS transactions (\n",
        "            id INTEGER PRIMARY KEY AUTOINCREMENT,\n",
        "            acc_no TEXT NOT NULL,\n",
        "            trans_type TEXT NOT NULL CHECK (trans_type IN\n",
        "            ('DEPOSIT','WITHDRAW','TRANSFER_IN','TRANSFER_OUT')),\n",
        "            amount INTEGER NOT NULL CHECK (amount > 0),\n",
        "            related_acc TEXT,\n",
        "            details TEXT,\n",
        "            trans_time TEXT NOT NULL,\n",
        "            FOREIGN KEY (acc_no) REFERENCES accounts(acc_no) ON DELETE RESTRICT\n",
        "        )\n",
        "    \"\"\")\n",
        "    con.close()\n",
        "    try:\n",
        "        os.chmod(DB_NAME, 0o600)\n",
        "    except OSError:\n",
        "        pass\n",
        "\n",
        "def now():\n",
        "    return datetime.now().strftime(\"%Y-%m-%d %H:%M:%S\")\n",
        "\n",
        "def _scrypt(pin, salt):\n",
        "    return hashlib.scrypt(pin.encode(), salt=salt, n=2**14, r=8, p=1, dklen=32)\n",
        "\n",
        "def make_pin_hash(pin):\n",
        "    salt = os.urandom(16)\n",
        "    return f\"scrypt${salt.hex()}${_scrypt(pin, salt).hex()}\"\n",
        "\n",
        "def check_pin(pin, saved_pin):\n",
        "    try:\n",
        "        algo, salt_hex, hash_hex = saved_pin.split(\"$\")\n",
        "        if algo != \"scrypt\":\n",
        "            return False\n",
        "        new_hash = _scrypt(pin, bytes.fromhex(salt_hex))\n",
        "        return hmac.compare_digest(new_hash, bytes.fromhex(hash_hex))\n",
        "    except ValueError:\n",
        "        return False\n",
        "\n",
        "DUMMY_HASH = make_pin_hash(\"000000\")\n",
        "\n",
        "def verify_pin_for_account(acc_no, pin):\n",
        "    \"\"\"Checks the PIN with brute-force protection. Returns (ok, message).\"\"\"\n",
        "    con = connect_db()\n",
        "    try:\n",
        "        row = con.execute(\n",
        "            \"SELECT pin, failed_attempts, locked_until FROM accounts \"\n",
        "            \"WHERE acc_no = ? AND is_active = 1\", (acc_no,)\n",
        "        ).fetchone()\n",
        "        if not row:\n",
        "            check_pin(pin, DUMMY_HASH)\n",
        "            return False, \"Invalid account number or PIN.\"\n",
        "\n",
        "        saved, failed, locked_until = row\n",
        "        if locked_until and datetime.fromisoformat(locked_until) > datetime.now():\n",
        "            logging.warning(\"Attempt on locked account %s\", acc_no)\n",
        "            return False, \"Too many failed attempts. Try again later.\"\n",
        "\n",
        "        if check_pin(pin, saved):\n",
        "            con.execute(\n",
        "                \"UPDATE accounts SET failed_attempts = 0, locked_until = NULL \"\n",
        "                \"WHERE acc_no = ?\", (acc_no,))\n",
        "            return True, \"\"\n",
        "\n",
        "        failed += 1\n",
        "        if failed >= MAX_ATTEMPTS:\n",
        "            until = (datetime.now() + timedelta(minutes=LOCK_MINUTES)).isoformat(timespec=\"seconds\")\n",
        "            con.execute(\n",
        "                \"UPDATE accounts SET failed_attempts = 0, locked_until = ? \"\n",
        "                \"WHERE acc_no = ?\", (until, acc_no))\n",
        "            logging.warning(\"Account %s locked after repeated failures\", acc_no)\n",
        "        else:\n",
        "            con.execute(\n",
        "                \"UPDATE accounts SET failed_attempts = ? WHERE acc_no = ?\",\n",
        "                (failed, acc_no))\n",
        "        logging.warning(\"Failed PIN attempt for account %s\", acc_no)\n",
        "        return False, \"Invalid account number or PIN.\"\n",
        "    finally:\n",
        "        con.close()\n",
        "\n",
        "ACC_RE = re.compile(r\"\\d{8}\")\n",
        "PHONE_RE = re.compile(r\"\\+?\\d{7,15}\")\n",
        "EMAIL_RE = re.compile(r\"[^@\\s]+@[^@\\s]+\\.[^@\\s]+\")\n",
        "\n",
        "def valid_acc_no(value):\n",
        "    return bool(ACC_RE.fullmatch(value))\n",
        "\n",
        "def read_valid(prompt, check, error, default=None):\n",
        "    while True:\n",
        "        value = input(prompt).strip()\n",
        "        if not value and default is not None:\n",
        "            return default\n",
        "        if check(value):\n",
        "            return value\n",
        "        print(error)\n",
        "\n",
        "def read_name(default=None):\n",
        "    prompt = f\"Name [{default}]: \" if default else \"Name: \"\n",
        "    return read_valid(prompt, lambda v: 0 < len(v) <= 100 and v.isprintable(),\n",
        "                      \"Name must be 1-100 printable characters.\", default)\n",
        "\n",
        "def read_phone(default=None):\n",
        "    prompt = f\"Phone [{default}]: \" if default else \"Phone: \"\n",
        "    return read_valid(prompt, lambda v: bool(PHONE_RE.fullmatch(v)),\n",
        "                      \"Phone must be 7-15 digits (optional leading +).\", default)\n",
        "\n",
        "def read_email(default=None):\n",
        "    prompt = f\"Email [{default}]: \" if default else \"Email: \"\n",
        "    return read_valid(prompt, lambda v: len(v) <= 254 and bool(EMAIL_RE.fullmatch(v)),\n",
        "                      \"Please enter a valid email address.\", default)\n",
        "\n",
        "def read_address(default=None):\n",
        "    prompt = f\"Address [{default}]: \" if default else \"Address: \"\n",
        "    return read_valid(prompt, lambda v: 0 < len(v) <= 200 and v.isprintable(),\n",
        "                      \"Address must be 1-200 printable characters.\", default)\n",
        "\n",
        "def read_pin(message=\"PIN: \"):\n",
        "    while True:\n",
        "        pin = getpass(message).strip()\n",
        "        if pin.isascii() and pin.isdigit() and 4 <= len(pin) <= 6:\n",
        "            return pin\n",
        "        print(\"PIN must contain 4 to 6 digits.\")\n",
        "\n",
        "def is_weak_pin(pin):\n",
        "    return (len(set(pin)) == 1\n",
        "            or pin in \"0123456789\"\n",
        "            or pin in \"9876543210\")\n",
        "\n",
        "def read_amount(message=\"Amount: \"):\n",
        "    \"\"\"Returns the amount in cents (int). Rejects NaN/inf, >2 decimals, huge values.\"\"\"\n",
        "    while True:\n",
        "        value = input(message).strip()\n",
        "        try:\n",
        "            amt = Decimal(value)\n",
        "        except InvalidOperation:\n",
        "            print(\"Please enter a valid number.\")\n",
        "            continue\n",
        "        if not amt.is_finite() or amt <= 0:\n",
        "            print(\"Amount must be a positive number.\")\n",
        "        elif amt > MAX_AMOUNT:\n",
        "            print(f\"Maximum amount per operation is {MAX_AMOUNT}.\")\n",
        "        elif amt.as_tuple().exponent < -2:\n",
        "            print(\"Amount can have at most 2 decimal places.\")\n",
        "        else:\n",
        "            return int(amt * 100)\n",
        "\n",
        "def money(cents):\n",
        "    return f\"{cents // 100}.{cents % 100:02d}\"\n",
        "\n",
        "def reauthenticate(acc_no):\n",
        "    \"\"\"Ask for the PIN again before sensitive operations.\"\"\"\n",
        "    ok, msg = verify_pin_for_account(acc_no, read_pin(\"Confirm your PIN: \"))\n",
        "    if not ok:\n",
        "        print(msg)\n",
        "    return ok\n",
        "\n",
        "def get_account(acc_no):\n",
        "    con = connect_db()\n",
        "    row = con.execute(\n",
        "        \"SELECT acc_no, name, phone, email, address \"\n",
        "        \"FROM accounts WHERE acc_no = ? AND is_active = 1\",\n",
        "        (acc_no,)\n",
        "    ).fetchone()\n",
        "    con.close()\n",
        "    return row\n",
        "\n",
        "def generate_acc_no():\n",
        "    return str(10_000_000 + secrets.randbelow(90_000_000))\n",
        "\n",
        "def create_account():\n",
        "    print(\"\\n--- Create New Account ---\")\n",
        "    name = read_name()\n",
        "    phone = read_phone()\n",
        "    email = read_email()\n",
        "    address = read_address()\n",
        "    while True:\n",
        "        pin = read_pin(\"Choose PIN (4-6 digits): \")\n",
        "        if is_weak_pin(pin):\n",
        "            print(\"PIN is too easy to guess (e.g. 1111, 1234). Choose another.\")\n",
        "            continue\n",
        "        break\n",
        "    while True:\n",
        "        confirm = read_pin(\"Confirm PIN: \")\n",
        "        if confirm == pin:\n",
        "            break\n",
        "        print(\"PINs do not match.\")\n",
        "\n",
        "    pin_hash = make_pin_hash(pin)\n",
        "    for _ in range(10):\n",
        "        acc_no = generate_acc_no()\n",
        "        con = connect_db()\n",
        "        try:\n",
        "            con.execute(\n",
        "                \"INSERT INTO accounts \"\n",
        "                \"(acc_no, name, phone, email, address, pin, created_at) \"\n",
        "                \"VALUES (?, ?, ?, ?, ?, ?, ?)\",\n",
        "                (acc_no, name, phone, email, address, pin_hash, now()))\n",
        "            print(\"Account created successfully.\")\n",
        "            print(\"Your account number is:\", acc_no)\n",
        "            logging.info(\"Account created: %s\", acc_no)\n",
        "            return\n",
        "        except sqlite3.IntegrityError:\n",
        "            continue\n",
        "        finally:\n",
        "            con.close()\n",
        "    print(\"Could not create the account. Please try again.\")\n",
        "\n",
        "def login():\n",
        "    print(\"\\n--- User Login ---\")\n",
        "    acc_no = input(\"Account number: \").strip()\n",
        "    pin = read_pin()\n",
        "    ok, msg = verify_pin_for_account(acc_no, pin)\n",
        "    if ok:\n",
        "        print(\"Login successful.\")\n",
        "        logging.info(\"Login success: %s\", acc_no)\n",
        "        return acc_no\n",
        "    print(msg)\n",
        "    return None\n",
        "\n",
        "def display_info(acc_no):\n",
        "    row = get_account(acc_no)\n",
        "    if not row:\n",
        "        print(\"Account not found.\")\n",
        "        return\n",
        "    print(\"\\n--- Account Information ---\")\n",
        "    print(\"Account number:\", row[0])\n",
        "    print(\"Name:\", row[1])\n",
        "    print(\"Phone:\", row[2])\n",
        "    print(\"Email:\", row[3])\n",
        "    print(\"Address:\", row[4])\n",
        "\n",
        "def balance_of(con, acc_no):\n",
        "    row = con.execute(\n",
        "        \"SELECT COALESCE(SUM(CASE WHEN trans_type IN ('DEPOSIT','TRANSFER_IN') \"\n",
        "        \"THEN amount ELSE -amount END), 0) \"\n",
        "        \"FROM transactions WHERE acc_no = ?\", (acc_no,)\n",
        "    ).fetchone()\n",
        "    return row[0]\n",
        "\n",
        "def get_balance(acc_no):\n",
        "    con = connect_db()\n",
        "    try:\n",
        "        return balance_of(con, acc_no)\n",
        "    finally:\n",
        "        con.close()\n",
        "\n",
        "def add_transaction(con, acc_no, trans_type, amount, related_acc=None, details=\"\"):\n",
        "    con.execute(\n",
        "        \"INSERT INTO transactions \"\n",
        "        \"(acc_no, trans_type, amount, related_acc, details, trans_time) \"\n",
        "        \"VALUES (?, ?, ?, ?, ?, ?)\",\n",
        "        (acc_no, trans_type, amount, related_acc, details, now()))\n",
        "\n",
        "def deposit(acc_no):\n",
        "    print(\"\\n--- Deposit Money ---\")\n",
        "    amt = read_amount()\n",
        "    try:\n",
        "        with db_transaction() as con:\n",
        "            add_transaction(con, acc_no, \"DEPOSIT\", amt, details=\"Cash deposit\")\n",
        "            new_bal = balance_of(con, acc_no)\n",
        "    except sqlite3.Error:\n",
        "        logging.exception(\"Deposit failed for %s\", acc_no)\n",
        "        print(\"Deposit failed. Please try again.\")\n",
        "        return\n",
        "    logging.info(\"Deposit %s on %s\", money(amt), acc_no)\n",
        "    print(f\"Deposit successful. New balance: {money(new_bal)}\")\n",
        "\n",
        "def withdraw(acc_no):\n",
        "    print(\"\\n--- Withdraw Money ---\")\n",
        "    amt = read_amount()\n",
        "    if not reauthenticate(acc_no):\n",
        "        return\n",
        "    try:\n",
        "        with db_transaction() as con:\n",
        "            if amt > balance_of(con, acc_no):\n",
        "                raise BankError(\"Insufficient balance.\")\n",
        "            add_transaction(con, acc_no, \"WITHDRAW\", amt, details=\"Cash withdrawal\")\n",
        "            new_bal = balance_of(con, acc_no)\n",
        "    except BankError as e:\n",
        "        print(e)\n",
        "        return\n",
        "    except sqlite3.Error:\n",
        "        logging.exception(\"Withdraw failed for %s\", acc_no)\n",
        "        print(\"Withdrawal failed. No changes were made.\")\n",
        "        return\n",
        "    logging.info(\"Withdraw %s from %s\", money(amt), acc_no)\n",
        "    print(f\"Withdrawal successful. New balance: {money(new_bal)}\")\n",
        "\n",
        "def transfer(acc_no):\n",
        "    print(\"\\n--- Transfer Money ---\")\n",
        "    to_acc = input(\"Receiver account number: \").strip()\n",
        "    if not valid_acc_no(to_acc):\n",
        "        print(\"Invalid account number format.\")\n",
        "        return\n",
        "    if to_acc == acc_no:\n",
        "        print(\"You cannot transfer money to the same account.\")\n",
        "        return\n",
        "    amt = read_amount()\n",
        "    if not reauthenticate(acc_no):\n",
        "        return\n",
        "    try:\n",
        "        with db_transaction() as con:\n",
        "            exists = con.execute(\n",
        "                \"SELECT 1 FROM accounts WHERE acc_no = ? AND is_active = 1\",\n",
        "                (to_acc,)).fetchone()\n",
        "            if not exists:\n",
        "                raise BankError(\"Receiver account does not exist.\")\n",
        "            if amt > balance_of(con, acc_no):\n",
        "                raise BankError(\"Insufficient balance.\")\n",
        "            add_transaction(con, acc_no, \"TRANSFER_OUT\", amt, to_acc, \"Money sent\")\n",
        "            add_transaction(con, to_acc, \"TRANSFER_IN\", amt, acc_no, \"Money received\")\n",
        "            new_bal = balance_of(con, acc_no)\n",
        "    except BankError as e:\n",
        "        print(e)\n",
        "        return\n",
        "    except sqlite3.Error:\n",
        "        logging.exception(\"Transfer failed for %s\", acc_no)\n",
        "        print(\"Transfer failed. No account was changed.\")\n",
        "        return\n",
        "    logging.info(\"Transfer %s from %s to %s\", money(amt), acc_no, to_acc)\n",
        "    print(f\"Transfer successful. New balance: {money(new_bal)}\")\n",
        "\n",
        "def show_balance(acc_no):\n",
        "    print(f\"Current balance: {money(get_balance(acc_no))}\")\n",
        "\n",
        "def show_history(acc_no):\n",
        "    print(\"\\n--- Transaction History ---\")\n",
        "    con = connect_db()\n",
        "    rows = con.execute(\n",
        "        \"SELECT trans_type, amount, related_acc, details, trans_time \"\n",
        "        \"FROM transactions WHERE acc_no = ? ORDER BY id DESC LIMIT 100\", (acc_no,)\n",
        "    ).fetchall()\n",
        "    con.close()\n",
        "    if not rows:\n",
        "        print(\"No transactions found.\")\n",
        "        return\n",
        "    for row in rows:\n",
        "        related = f\" | Related account: {row[2]}\" if row[2] else \"\"\n",
        "        print(f\"{row[4]} | {row[0]} | {money(row[1])}{related} | {row[3]}\")\n",
        "\n",
        "def update_account(acc_no):\n",
        "    print(\"\\n--- Update Account Information ---\")\n",
        "    row = get_account(acc_no)\n",
        "    if not row:\n",
        "        print(\"Account not found.\")\n",
        "        return\n",
        "    name = read_name(row[1])\n",
        "    phone = read_phone(row[2])\n",
        "    email = read_email(row[3])\n",
        "    address = read_address(row[4])\n",
        "    con = connect_db()\n",
        "    con.execute(\n",
        "        \"UPDATE accounts SET name = ?, phone = ?, email = ?, address = ? \"\n",
        "        \"WHERE acc_no = ? AND is_active = 1\",\n",
        "        (name, phone, email, address, acc_no))\n",
        "    con.close()\n",
        "    logging.info(\"Account info updated: %s\", acc_no)\n",
        "    print(\"Account information updated successfully.\")\n",
        "\n",
        "def delete_account(acc_no):\n",
        "    print(\"\\n--- Delete Bank Account ---\")\n",
        "    confirm = input(\"Type DELETE to confirm: \").strip()\n",
        "    if confirm != \"DELETE\":\n",
        "        print(\"Deletion cancelled.\")\n",
        "        return False\n",
        "    if not reauthenticate(acc_no):\n",
        "        print(\"Account was not deleted.\")\n",
        "        return False\n",
        "    try:\n",
        "        with db_transaction() as con:\n",
        "            if balance_of(con, acc_no) != 0:\n",
        "                raise BankError(\"Withdraw or transfer your remaining balance before closing the account.\")\n",
        "            con.execute(\"UPDATE accounts SET is_active = 0 WHERE acc_no = ?\", (acc_no,))\n",
        "    except BankError as e:\n",
        "        print(e)\n",
        "        return False\n",
        "    except sqlite3.Error:\n",
        "        logging.exception(\"Delete failed for %s\", acc_no)\n",
        "        print(\"Could not close the account.\")\n",
        "        return False\n",
        "    logging.info(\"Account closed: %s\", acc_no)\n",
        "    print(\"Account deleted successfully.\")\n",
        "    return True\n",
        "\n",
        "def user_menu(acc_no):\n",
        "    while True:\n",
        "        print(\"\\n=== User Menu ===\")\n",
        "        print(\"1. Display Account Information\")\n",
        "        print(\"2. Deposit Money\")\n",
        "        print(\"3. Withdraw Money\")\n",
        "        print(\"4. Transfer Money\")\n",
        "        print(\"5. Check Balance\")\n",
        "        print(\"6. View Transaction History\")\n",
        "        print(\"7. Update Account Information\")\n",
        "        print(\"8. Delete Bank Account\")\n",
        "        print(\"9. Logout\")\n",
        "        choice = input(\"Choose an option: \").strip()\n",
        "        if choice == \"1\":\n",
        "            display_info(acc_no)\n",
        "        elif choice == \"2\":\n",
        "            deposit(acc_no)\n",
        "        elif choice == \"3\":\n",
        "            withdraw(acc_no)\n",
        "        elif choice == \"4\":\n",
        "            transfer(acc_no)\n",
        "        elif choice == \"5\":\n",
        "            show_balance(acc_no)\n",
        "        elif choice == \"6\":\n",
        "            show_history(acc_no)\n",
        "        elif choice == \"7\":\n",
        "            update_account(acc_no)\n",
        "        elif choice == \"8\":\n",
        "            if delete_account(acc_no):\n",
        "                return\n",
        "        elif choice == \"9\":\n",
        "            print(\"Logged out successfully.\")\n",
        "            return\n",
        "        else:\n",
        "            print(\"Invalid choice. Please try again.\")\n",
        "\n",
        "def main():\n",
        "    init_db()\n",
        "    try:\n",
        "        while True:\n",
        "            print(\"\\n BANK MANAGEMENT SYSTEM\")\n",
        "            print(\"1. Create New Account\")\n",
        "            print(\"2. User Login\")\n",
        "            print(\"3. Exit\")\n",
        "            choice = input(\"Choose an option: \").strip()\n",
        "            if choice == \"1\":\n",
        "                create_account()\n",
        "            elif choice == \"2\":\n",
        "                acc_no = login()\n",
        "                if acc_no:\n",
        "                    user_menu(acc_no)\n",
        "            elif choice == \"3\":\n",
        "                print(\"Thank you for using the system.\")\n",
        "                break\n",
        "            else:\n",
        "                print(\"Invalid choice. Please try again.\")\n",
        "    except (KeyboardInterrupt, EOFError):\n",
        "        print(\"\\nGoodbye.\")\n",
        "\n",
        "if __name__ == \"__main__\":\n",
        "    main()"
      ]
    }
  ]
}
